.vscode/
.idea/
.DS_Store
*.swp

# HuggingFace / model caches
.cache/
cache/
hf_cache/

# Raw image datasets — users should place them here for local eval
dataset/*
!dataset/.gitkeep
# Benchmark manifest JSONs are shipped with the repo; only exclude local backups
data/*.json.bak
!data/.gitkeep

# Experiment outputs — ignore everything except results.json (final metrics)
output_lead/
output_lead_test/
output_rebuttal/
output_rebuttal.tar.gz
output/**
!output/
!output/**/
!output/**/results.json
logs/
*.log

# Ephemeral / editor backups
*.bak
*.tmp
*~

# Large archives
*.tar.gz
*.zip
*.pt
*.bin
*.safetensors

# Jupyter
.ipynb_checkpoints/
